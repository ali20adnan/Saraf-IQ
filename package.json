    "@capacitor/status-bar": "^7.0.1",
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.101.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
