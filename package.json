    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
