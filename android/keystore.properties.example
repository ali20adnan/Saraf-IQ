# انسخ هذا الملف إلى keystore.properties في نفس المجلد (android/)
# ولا ترفع keystore.properties أو ملف المفتاح إلى Git.
#
# إنشاء مفتاح (مرة واحدة)، من مجلد android/app:
#   keytool -genkey -v -keystore release.keystore -alias saraf -keyalg RSA -keysize 2048 -validity 10000
#
# المسارات أدناه نسبية إلى مجلد android/app/ عند البناء
storeFile=release.keystore
storePassword=your_store_password
keyAlias=saraf
keyPassword=your_key_password
