# Railway PostgreSQL — full app data + local auth (required in production)
# On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Local: use Postgres "Public Network" URL from Railway dashboard
# DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"
# DATABASE_PUBLIC_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"

# Optional: first admin account (created only if no admin users exist)
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="change-me-now"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# Optional: Telegram bot rate texts
EXCHANGE_BUY_RATE="مثال: 98,000 دينار لكل 100k اسيا"
EXCHANGE_SELL_RATE="مثال: 95,000 دينار لكل 100k اسيا"

# Optional: external APK URL
# VITE_APK_URL="https://example.com/saraf-iq.apk"
# APK_DOWNLOAD_URL="https://github.com/org/repo/releases/download/v1/app-debug.apk"
# PUBLIC_BASE_URL="https://app.example.com"

# Firebase Cloud Messaging (APK push)
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...",...}'

# Railway sets automatically
# RAILWAY_PUBLIC_DOMAIN="your-app.up.railway.app"

# Capacitor/APK: API origin (no trailing slash)
# VITE_APP_API_ORIGIN="https://your-service.up.railway.app"

# Optional CORS allow-list
# CORS_ALLOWED_ORIGINS="https://saraf.asia,https://www.saraf.asia"
