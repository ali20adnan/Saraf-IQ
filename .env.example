# Supabase (واجهة + خادم)
# — على Railway: يكفي ضبط هذه القيم في لوحة المتغيرات؛ الواجهة تقرأ /api/public-config في الإنتاج
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# بديل لاسم المفتاح في العمومي فقط (اختياري)
# PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# اختياري: نصوص بوت تيليجرام (سعر الصرف)
EXCHANGE_BUY_RATE="مثال: 98,000 دينار لكل 100k اسيا"
EXCHANGE_SELL_RATE="مثال: 95,000 دينار لكل 100k اسيا"

# اختياري: رابط APK خارجي
# VITE_APK_URL="https://example.com/saraf-iq.apk"

# خادم Express: إعادة توجيه /saraf-iq-debug.apk إلى رابط مباشر
# APK_DOWNLOAD_URL="https://github.com/org/repo/releases/download/v1/app-debug.apk"

# اختياري: دومين مخصص لـ /api/apk-link
# PUBLIC_BASE_URL="https://app.example.com"

# Railway يضيفها تلقائياً — تُستخدم في الخادم لروابط التحميل
# RAILWAY_PUBLIC_DOMAIN="your-app.up.railway.app"

# تطبيق Capacitor/APK: رابط خادمك على Railway (بدون / في النهاية) لجلب إعداد Supabase من /api/public-config
# نفس القيمة يجب أن تكون في Railway Variables — المتغيرات هناك لا تصل للـ APK تلقائياً
#
# Android: أنشئ android/.env وضع VITE_APP_API_ORIGIN=رابط_Railway ثم npm run apk
# بديل: نفس المتغير في .env هنا، أو public/saraf-api.json
# VITE_APP_API_ORIGIN="https://your-service.up.railway.app"
#
# اختبار API من المتصفح (استبدل الدومين):
# https://your-service.up.railway.app/api/public-config
