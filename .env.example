# Supabase (واجهة + خادم)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# اختياري: نصوص بوت تيليجرام (سعر الصرف)
EXCHANGE_BUY_RATE="مثال: 98,000 دينار لكل 100k اسيا"
EXCHANGE_SELL_RATE="مثال: 95,000 دينار لكل 100k اسيا"

# اختياري: رابط APK خارجي
# VITE_APK_URL="https://example.com/saraf-iq.apk"

# خادم Express: إعادة توجيه /saraf-iq-debug.apk إلى رابط مباشر
# APK_DOWNLOAD_URL="https://github.com/org/repo/releases/download/v1/app-debug.apk"

